# DETECTIVE research worker — secrets for THIS process only.
# Copy to research-worker/.env (gitignored) or inject via host secrets manager.
# NEVER put these keys in the Next.js web app .env.local for research.

# Cases DB only (restricted writer role — see sql/restricted_role.sql).
# Do NOT point at the main users/auth DATABASE_URL.
CASES_DATABASE_URL="postgresql://research_worker:PASSWORD@HOST:5432/detective_cases"

# OpenAI — worker host / secrets manager only (required for live research)
OPENAI_API_KEY=""
OPENAI_MODEL_EXTRACT="gpt-4o-mini"
OPENAI_MODEL_VERIFY="gpt-4o"
OPENAI_MODEL_LIGHT="gpt-4o-mini"

# Search: NO API KEY REQUIRED.
# Default discovery = Wikipedia OpenSearch + allowlisted DuckDuckGo HTML results.
# Optional Brave (only if you already have a key):
# BRAVE_API_KEY=""
# BRAVE_SEARCH_BASE_URL="https://api.search.brave.com/res/v1/web/search"

# Pipeline limits (prompt-injection + cost defenses)
RESEARCH_MAX_STEPS="12"
RESEARCH_MAX_PAGES="20"
RESEARCH_MAX_COST="5"
RESEARCH_TIMEOUT_MS="60000"
RESEARCH_RETRIES="3"
RESEARCH_SCHEMA_RETRIES="2"
# RESEARCH_SOURCE_ALLOWLIST="www.archives.gov,www.justice.gov"
# RESEARCH_USER_AGENT="DETECTIVE-CASE-NET-ResearchBot/1.0"

# Worker loop
WORKER_POLL_INTERVAL_SEC="5"
WORKER_IDLE_SLEEP_SEC="5"
# Optional private webhook token (not required — prefer DB poll)
# RESEARCH_WORKER_TOKEN=""
