# DETECTIVE — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.

# PostgreSQL (required for Prisma auth + domain models)
# Local example after creating role/db:
#   postgresql://detective:detective@localhost:5432/detective?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/detective?schema=public"

# After pulling schema changes:
#   npx prisma migrate dev
#   npm run db:seed          # fictional FC-001 only — no real-crime seed
#   npm run db:spotcheck     # verify seed counts


# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email provider not wired in Phase 2 — password reset & email verification
# return clear development placeholder links instead of sending mail.
AUTH_EMAIL_PLACEHOLDER="true"
