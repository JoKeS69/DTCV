# DETECTIVE — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.

# PostgreSQL (required for Prisma auth + domain models)
# Local example after creating role/db:
#   postgresql://detective:detective@localhost:5432/detective?schema=public
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/detective?schema=public"

# After pulling schema changes:
#   npx prisma migrate dev
#   npm run db:seed          # production-safe: achievements only (no real cases)
#   npm run db:seed:dev      # LOCAL/CI only: demo users + FC training + DEV stubs
#   npm run db:spotcheck     # verify seed counts (expects db:seed:dev)


# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email provider not wired — set true ONLY for local/dev so reset/verify links
# may be returned in action responses. Ignored / blocked in production
# (NODE_ENV=production or VERCEL_ENV=production) — tokens never echoed to clients.
AUTH_EMAIL_PLACEHOLDER="true"

# Set to 1 for Playwright/local e2e so auth rate limits do not trip mid-suite.
# Never enable in production (code forbids bypass when NODE_ENV/VERCEL_ENV=production).
E2E_TEST="0"
# DISABLE_RATE_LIMIT="1"  # local only — ignored/forbidden in production

# ─── Field encryption / blind index (security remediation) ────────────────────
# AES-256-GCM field DEK material. REQUIRED in production.
# Dev may fall back to a derivation from AUTH_SECRET — never commit real keys.
# Production: inject via cloud secret manager / KMS-unwrapped DEK (see SECURITY.md).
ENCRYPTION_KEY="replace-with-openssl-rand-base64-32"
# HMAC key for email blind-index lookups. REQUIRED in production. Separate from ENCRYPTION_KEY.
EMAIL_BLIND_INDEX_KEY="replace-with-openssl-rand-base64-32"
# Optional pepper for short-TTL network rate-limit HMAC keys (defaults from AUTH_SECRET in dev).
# RATE_LIMIT_PEPPER="replace-with-openssl-rand-base64-32"

# ─── Payments (Phase 10) — Visa via provider abstraction ──────────────────────
# test = local Visa checkout (dev_visa). live = requires VISA_GATEWAY_* secrets.
PAYMENTS_MODE="test"
# Optional override: dev_visa | visa_gateway
# PAYMENTS_PROVIDER="dev_visa"

# Investigator Pro pricing (UI reads these — do not hard-code amounts in components)
PAYMENTS_PRO_AMOUNT_CENTS="1200"
PAYMENTS_PRO_CURRENCY="usd"
PAYMENTS_PRO_INTERVAL="month"
PAYMENTS_PRO_LABEL="Investigator Pro"
PAYMENTS_FREE_LABEL="Free"

# HMAC secret for /api/payments/webhook (x-detective-signature)
# REQUIRED — no hard-coded fallback. Generate: openssl rand -base64 32
# Do not use the example placeholder string in real environments.
PAYMENTS_WEBHOOK_SECRET="replace-with-a-long-random-webhook-secret"

# Live Visa-accepting gateway (CyberSource-shaped).
# REQUIRED when PAYMENTS_MODE=live — live never falls back to dev_visa.
VISA_GATEWAY_MERCHANT_ID=""
VISA_GATEWAY_API_KEY_ID=""
VISA_GATEWAY_API_SECRET=""
VISA_GATEWAY_BASE_URL="https://apitest.cybersource.com"

# Test Visa PANs (PAYMENTS_MODE=test only):
#   Success: 4111111111111111 or 4242424242424242
#   Decline: 4000000000000002

# ─── Production / domain (Phase 14) ───────────────────────────────────────────
# Canonical public hostname (documentation + future absolute URL helpers)
NEXT_PUBLIC_APP_DOMAIN="detective.example.com"

# ERROR MONITORING PLACEHOLDER — leave empty until a provider DSN is ready
# ERROR_MONITORING_DSN="https://<key>@<host>/<project>"

# ANALYTICS PLACEHOLDER — off by default; never send PII
NEXT_PUBLIC_ANALYTICS_ENABLED="false"
# NEXT_PUBLIC_ANALYTICS_WRITE_KEY=""

# Production checklist (see docs/PRODUCTION.md):
# - AUTH_EMAIL_PLACEHOLDER=false
# - E2E_TEST unset or 0
# - ENCRYPTION_KEY + EMAIL_BLIND_INDEX_KEY set via KMS/secret manager (not git)
# - PAYMENTS_WEBHOOK_SECRET = long random (not example placeholder)
# - PAYMENTS_MODE=live only with VISA_GATEWAY_* set
# - Prefer Visa hosted fields; do not integrate Stripe
