# DETECTIVE — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.

# PostgreSQL (required for Prisma + auth at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/detective?schema=public"

# Auth.js / NextAuth
# Generate: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Public site URL
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email provider not wired in Phase 2 — password reset & email verification
# return clear development placeholder links instead of sending mail.
AUTH_EMAIL_PLACEHOLDER="true"
