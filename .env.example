# DETECTIVE — environment variables
# Copy to `.env.local` for local development. Never commit real secrets.

# PostgreSQL connection string (required for Prisma at runtime)
# Local example: postgresql://postgres:postgres@localhost:5432/detective?schema=public
# Vercel: set this in Project Settings → Environment Variables
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/detective?schema=public"

# Public site URL (sitemap, Open Graph, absolute links). Optional in Phase 0.
# NEXT_PUBLIC_SITE_URL="https://your-domain.vercel.app"
