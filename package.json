{
  "name": "detective",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run db:generate:all && next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "npm run db:generate:all",
    "db:generate": "prisma generate",
    "db:generate:cases": "prisma generate --config prisma-cases.config.ts",
    "db:generate:all": "prisma generate && prisma generate --config prisma-cases.config.ts",
    "db:validate": "prisma validate",
    "db:validate:cases": "prisma validate --config prisma-cases.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:cases": "prisma migrate dev --config prisma-cases.config.ts",
    "db:deploy": "prisma migrate deploy",
    "db:deploy:cases": "prisma migrate deploy --config prisma-cases.config.ts",
    "db:deploy:cases:safe": "bash scripts/deploy-cases-db.sh",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:dev": "tsx prisma/seed.dev.ts",
    "db:cases:seed": "tsx prisma-cases/seed.ts",
    "db:spotcheck": "tsx prisma/spotcheck.ts",
    "db:prod-check": "tsx scripts/db-prod-check.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:legacy": "tsx scripts/run-legacy-e2e.ts",
    "test:all": "npm run test:unit && npm run test:e2e"
  },
  "prisma": {
    "seed": "tsx prisma/seed.dev.ts"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^17.2.3",
    "leaflet": "^1.9.4",
    "lucide-react": "^1.48.0",
    "next": "16.3.6",
    "next-auth": "^5.0.0-beta.32",
    "openai": "^7.27.0",
    "pg": "^8.16.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-leaflet": "^5.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^20",
    "@types/pg": "^8.15.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "playwright": "^1.63.0",
    "prisma": "^7.10.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
