// DETECTIVE case-research database (separate from main site DB).
// Research agent and /pb-case write ONLY here — never users/auth/settings.

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma-cases"
}

datasource db {
  // Built-in file DB — no Postgres install/password for cases research.
  // Auth/users stay on the main DATABASE_URL (Postgres or whatever the site uses).
  provider = "sqlite"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum ResearchCaseStatus {
  draft
  researching
  pending_review
  published
  unpublished
  archived
}

enum ClaimReviewStatus {
  pending
  approved
  rejected
  disputed
}

enum PersonReviewStatus {
  pending
  approved
  rejected
}

enum ResearchRunStatus {
  queued
  running
  completed
  failed
  cancelled
}

enum CandidateStatus {
  new
  accepted
  rejected
  dismissed
}

enum TakedownRequestStatus {
  open
  reviewing
  resolved
  rejected
}

enum LegalPersonStatus {
  unidentified
  named_public_record
  person_of_interest
  charged
  convicted
  acquitted
  deceased
  other
}

// ─── Models ──────────────────────────────────────────────────────────────────

/// Curated investigation case file (research-agent / admin authored).
model CaseFile {
  id               String              @id @default(cuid())
  slug             String              @unique
  title            String
  /// Short factual synopsis only — no guilt declarations.
  summary          String              @default("")
  /// Optional free-text event date (e.g. "14 February 2005").
  eventDateText    String?
  /// Parsed/approx event date for sorting when known.
  eventDate        DateTime?
  location         String?
  status           ResearchCaseStatus  @default(draft)
  /// Free-form labels (JSON string array, e.g. ["cold_case"]).
  labels           Json                @default("[]")
  /// Homepage World Domination slot — at most 3 published across DB.
  worldDomination  Boolean             @default(false)
  /// Display string for legal posture of the case file.
  legalStatusNote  String?
  contentWarning   Boolean             @default(true)
  /// Prefer official/court/government sources guidance flag for UI.
  preferOfficialSources Boolean        @default(true)
  lastReviewedAt   DateTime?
  needsReverify    Boolean             @default(false)
  publishedAt      DateTime?
  publishedBy      String?
  /// Assembled draft body (paraphrased, sourced) — JSON document.
  draftContent     Json?
  /// Source list: [{url, title?, accessedAt?, excerpt?}]
  sources          Json?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  claims           Claim[]
  people           Person[]
  researchRuns     ResearchRun[]
  revisions        CaseRevision[]
  takedownRequests TakedownRequest[]

  @@index([status])
  @@index([worldDomination, status])
  @@index([needsReverify])
  @@map("cases")
}

model Claim {
  id               String            @id @default(cuid())
  caseId           String
  /// Claim text — must pass wording linter before publish.
  text             String
  status           ClaimReviewStatus @default(pending)
  /// When true, claim is intended for published surface (subject to approval gate).
  showOnPublish    Boolean           @default(true)
  disputed         Boolean           @default(false)
  confidence       Float?
  verificationNotes String?
  /// Source refs for this claim.
  sources          Json?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  case             CaseFile          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@map("claims")
}

model Person {
  id               String             @id @default(cuid())
  caseId           String
  name             String
  role             String             @default("other")
  status           PersonReviewStatus @default(pending)
  legalStatus      LegalPersonStatus  @default(other)
  /// Always remind: named persons are presumed innocent unless convicted.
  presumptionNote  String             @default("Presumed innocent unless proven guilty in a court of law.")
  sources          Json?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  case             CaseFile           @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@map("people")
}

model ResearchRun {
  id            String            @id @default(cuid())
  caseId        String
  status        ResearchRunStatus @default(queued)
  /// High-level plan produced by the agent.
  plan          Json?
  /// Step log including URLs fetched (no secrets).
  stepsLog      Json?
  pagesFetched  Int               @default(0)
  stepsUsed     Int               @default(0)
  /// Estimated cost units (provider-defined / token-derived).
  costUnits     Float             @default(0)
  /// OpenAI token usage for PB CASE cost visibility (never log API keys).
  promptTokens      Int           @default(0)
  completionTokens  Int           @default(0)
  totalTokens       Int           @default(0)
  errorMessage  String?
  startedAt     DateTime?
  finishedAt    DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  case          CaseFile          @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, status])
  @@index([status])
  @@map("research_runs")
}

/// Trending discovery inbox — candidates only; no deep research until admin accepts.
model Candidate {
  id            String          @id @default(cuid())
  title         String
  rationale     String          @default("")
  score         Float           @default(0)
  status        CandidateStatus @default(new)
  /// Source URLs as JSON string array.
  sourceUrls    Json            @default("[]")
  discoveredAt  DateTime        @default(now())
  reviewedAt    DateTime?
  linkedCaseId  String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([status, score])
  @@map("candidates")
}

model CaseRevision {
  id        String   @id @default(cuid())
  caseId    String
  snapshot  Json
  note      String?
  createdBy String?
  createdAt DateTime @default(now())

  case      CaseFile @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId, createdAt])
  @@map("case_revisions")
}

model AuditLog {
  id         String   @id @default(cuid())
  actor      String
  action     String
  entityType String
  entityId   String?
  meta       Json?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([entityType, entityId])
  @@map("audit_log")
}

model TakedownRequest {
  id              String                @id @default(cuid())
  caseId          String?
  url             String?
  /// Optional HMAC/hash of contact email — never store raw email.
  contactHash     String?
  reason          String
  status          TakedownRequestStatus @default(open)
  resolutionNote  String?
  createdAt       DateTime              @default(now())
  resolvedAt      DateTime?

  case            CaseFile?             @relation(fields: [caseId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("takedown_requests")
}

// ─── Investigation Mode (fictional whodunit — never sync to public /cases) ───

enum InvestigationCaseStatus {
  draft
  published
  archived
}

/// Original fictional whodunit case. Lives only in cases DB.
/// Publish → /fictional Investigation Mode ONLY (never public Case sync).
model InvestigationCase {
  id               String                   @id @default(cuid())
  slug             String                   @unique
  title            String
  teaser           String                   @default("")
  /// JSON string array of victim display names.
  victims          Json                     @default("[]")
  location         String                   @default("")
  discoveryReport  String                   @default("")
  weaponName       String                   @default("")
  weaponTrait      String                   @default("")
  /// Scenes: [{id,name,clue}] — clue hidden from client until inspected.
  locations        Json                     @default("[]")
  /// Suspects incl. isGuilty + private fields — NEVER send isGuilty/solution to client until closed.
  suspects         Json                     @default("[]")
  hasTwist         Boolean                  @default(false)
  twistNote        String?
  /// Optional darker terminal theme for special cases.
  darkerTheme      Boolean                  @default(false)
  /// Support agent roster shown in Contact agents (JSON array).
  fieldAgents      Json                     @default("[]")
  status           InvestigationCaseStatus  @default(draft)
  publishedAt      DateTime?
  publishedBy      String?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt

  playerStates     InvestigationPlayerState[]

  @@index([status])
  @@map("investigation_cases")
}

/// Per-player progress for an investigation case (userId string only — no FK to main DB).
model InvestigationPlayerState {
  id                   String   @id @default(cuid())
  caseId               String
  /// Logged-in user id from main DB, or null for guest cookie sessions.
  userId               String?
  /// Stable key: `user:<id>` or `guest:<token>`.
  playerKey            String
  displayName          String
  /// unsolved | solved_first_try | solved_after_n
  status               String   @default("unsolved")
  wrongAccusations     Int      @default(0)
  /// JSON string arrays of location/suspect ids discovered/reviewed.
  inspectedLocationIds Json     @default("[]")
  reviewedSuspectIds   Json     @default("[]")
  backgroundCheckedIds Json     @default("[]")
  alibiVerifiedIds     Json     @default("[]")
  /// Board pins: [{suspectId, clueId}]
  boardConnections     Json     @default("[]")
  /// Structured case-log entries (JSON array).
  caseLog              Json     @default("[]")
  /// Chat transcripts (JSON): {suspectId?: messages[], agentId?: messages[]}
  chatHistory          Json     @default("{}")
  closedAt             DateTime?
  /// Solution payload revealed only after correct accusation (JSON).
  solutionReveal       Json?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  case                 InvestigationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@unique([caseId, playerKey])
  @@index([playerKey])
  @@index([userId])
  @@map("investigation_player_states")
}
